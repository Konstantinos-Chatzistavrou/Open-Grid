# Self-Hosted Community Matchmaking & Party Broker Server (Open Grid)
FROM node:24-alpine
WORKDIR /app
COPY server/package*.json ./
RUN npm ci --omit=dev
COPY server/ ./
ENV PORT=9000
EXPOSE 9000
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:9000/health || exit 1
CMD ["npm", "start"]
