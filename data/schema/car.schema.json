{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "car/1",
  "title": "Car physics config (schema car/1). SI units. Body frame: x forward, y left, z up.",
  "type": "object",
  "required": ["schema", "name", "chassis", "front_axle", "rear_axle", "tire_front", "brakes", "engine", "drivetrain", "aero", "surface_grip"],
  "properties": {
    "schema": { "const": "car/1" },
    "name": { "type": "string" },
    "chassis": {
      "type": "object",
      "required": ["mass_kg", "cg_height_m", "weight_front", "wheelbase_m", "inertia_roll_kgm2", "inertia_pitch_kgm2", "inertia_yaw_kgm2"],
      "properties": {
        "mass_kg": { "type": "number", "exclusiveMinimum": 0 },
        "cg_height_m": { "type": "number", "exclusiveMinimum": 0 },
        "weight_front": { "type": "number", "minimum": 0, "maximum": 1 },
        "wheelbase_m": { "type": "number", "exclusiveMinimum": 0 },
        "inertia_roll_kgm2": { "type": "number", "exclusiveMinimum": 0 },
        "inertia_pitch_kgm2": { "type": "number", "exclusiveMinimum": 0 },
        "inertia_yaw_kgm2": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "front_axle": { "$ref": "#/$defs/axle" },
    "rear_axle": { "$ref": "#/$defs/axle" },
    "tire_front": { "$ref": "#/$defs/tire" },
    "tire_rear": { "$ref": "#/$defs/tire" },
    "brakes": {
      "type": "object", "required": ["max_total_torque_nm", "bias_front"],
      "properties": { "max_total_torque_nm": { "type": "number" }, "bias_front": { "type": "number", "minimum": 0, "maximum": 1 } }
    },
    "engine": {
      "type": "object",
      "required": ["torque_curve", "idle_rpm", "redline_rpm", "inertia_kgm2", "friction_const_nm", "friction_linear_nm_per_radps"],
      "properties": {
        "torque_curve": { "type": "array", "minItems": 2, "items": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }] } },
        "cylinders": { "type": "integer", "minimum": 1, "description": "Firing pulses per two crank revolutions (a rotary counts its rotors x 2). Drives the exhaust firing frequency." },
        "voice": { "enum": ["v8_crossplane", "v8_flatplane", "v8_supercharged", "v8_twin_turbo", "v12_na", "v10_screamer", "v6_tt", "flat6_na", "i6_forged", "rotary_4", "i4_turbo", "i5_turbo"], "description": "Engine sound id (same ids as data/cars/catalog.json engineVoice). Absent = guessed from the car name / cylinders." }
      }
    },
    "drivetrain": {
      "type": "object",
      "required": ["layout", "gear_ratios", "final_drive", "efficiency", "clutch_max_torque_nm", "driveline_inertia_kgm2"],
      "properties": {
        "layout": { "enum": ["rwd", "fwd", "awd"] },
        "transmission": { "enum": ["h_pattern", "dog_box", "dct", "auto_tc"], "description": "The car's gearbox: manual synchromesh (needs a clutch, can miss shifts), sequential dog-box, dual-clutch (clutches itself, cannot miss a shift) or torque-converter automatic. Absent = the engine default (the browser build uses h_pattern)." },
        "gear_ratios": { "type": "array", "description": "[reverse (<0), 0 = neutral, 1st, 2nd, ...]" },
        "front_diff": { "$ref": "#/$defs/diff" }, "rear_diff": { "$ref": "#/$defs/diff" }, "centre_diff": { "$ref": "#/$defs/diff" },
        "awd_front_split": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "aero": { "type": "object", "required": ["drag_area_m2", "downforce_area_m2", "front_balance"] },
    "surface_grip": { "type": "object", "additionalProperties": { "type": "number" } }
  },
  "$defs": {
    "axle": {
      "type": "object",
      "properties": {
        "steer_compliance_deg_per_kn": { "type": "number", "minimum": 0 },
        "static_camber_deg": { "type": "number" },
        "camber_gain_deg_per_m": { "type": "number" },
        "caster_deg": { "type": "number" },
        "kpi_deg": { "type": "number" },
        "kinematics": {
          "type": "object",
          "description": "Optional explicit 3D suspension hardpoints (left corner, axle-local frame: +X fwd, +Y left, +Z up from static ground).",
          "required": ["type", "lca_front", "lca_rear", "lca_outer", "tie_inner", "tie_outer"],
          "properties": {
            "type": { "enum": ["double_wishbone", "macpherson"] },
            "lca_front": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
            "lca_rear": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
            "lca_outer": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
            "uca_front": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
            "uca_rear": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
            "uca_outer": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
            "strut_top": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
            "tie_inner": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
            "tie_outer": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
            "shock_lower": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
            "shock_upper": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
          }
        }
      },
      "required": ["track_m", "spring_rate_n_per_m", "spring_rest_length_m", "max_compression_m", "damper_bump_ns_per_m", "damper_rebound_ns_per_m", "anti_roll_rate_n_per_m", "roll_centre_height_m"]
    },
    "tire": {
      "type": "object",
      "properties": {
        "vertical_stiffness_n_per_m": { "type": "number", "exclusiveMinimum": 0 },
        "rolling_resistance_v2": { "type": "number", "minimum": 0 },
        "compound": { "enum": ["road", "semi_slick", "slick"], "description": "thermal window, reset temperature and tread wear rate (core/src/config.cpp apply_compound)" },
        "temp_optimal_c": { "type": "number" },
        "temp_window_c": { "type": "number", "exclusiveMinimum": 0 },
        "start_temp_c": { "type": "number" },
        "wear_per_mj": { "type": "number", "minimum": 0 },
        "aligning": { "type": "object", "additionalProperties": { "type": "number" } }
      },
      "required": ["radius_m", "inertia_kgm2", "fz0_n", "longitudinal", "lateral", "combined", "relaxation_length_long_m", "relaxation_length_lat_m", "rolling_resistance"]
    },
    "diff": {
      "type": "object",
      "properties": { "type": { "enum": ["open", "locked", "lsd"] }, "preload_nm": { "type": "number" }, "power_ramp": { "type": "number" }, "coast_ramp": { "type": "number" } }
    }
  }
}
