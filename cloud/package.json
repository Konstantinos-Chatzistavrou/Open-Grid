{
  "name": "opengrid-cloud",
  "private": true,
  "type": "module",
  "description": "Open Grid online service: accounts, online career (XP, credits, purchases) and server-timed ranked race rooms. Cloudflare Workers + D1 + Durable Objects (free plan).",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "db:local": "wrangler d1 migrations apply opengrid --local",
    "db:remote": "wrangler d1 migrations apply opengrid --remote",
    "deploy": "wrangler deploy",
    "test": "node test/sim.mjs",
    "test:social": "node test/social.mjs",
    "test:pace": "node test/pace.mjs",
    "test:competitive": "node test/competitive.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.168.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true,
    "workerd@1.20261123.1": true
  }
}
