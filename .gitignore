# Validation download cache (input data is fetched, never committed)
/data/validation/.cache/

# Sanitizer build output
/core/build-asan/

# Unreal Engine project (ue5/) and plugin build outputs: regenerated by the editor and UnrealBuildTool
/ue5/Binaries/
/ue5/Intermediate/
/ue5/Saved/
/ue5/DerivedDataCache/
/ue5/.vs/
/ue5/.idea/
/ue5/*.sln
/ue5/*.slnx
/ue5/*.code-workspace
/ue5/*.VC.db
/ue5_plugin/OpenGridPhysics/Binaries/
