/ue5/Import/
/tools/ue5/node_modules/
/tools/assets/node_modules/

# Kit masters live on GitHub Releases, not in git (docs/kit.md): only their ledgers and licence evidence are committed.
# Fetch them with `node tools/assets/masters.mjs fetch`.
/assets_source/masters/kit/*/*
!/assets_source/masters/kit/*/source.json
!/assets_source/masters/kit/*/evidence/
# Unreal kit exports are generated locally from the masters (tools/assets/build_kit_*.py)
/ue5/SourceArt/Kit/

# EPA import cache (downloaded CSVs, not data to commit)
data/validation/.cache/
/dist/
