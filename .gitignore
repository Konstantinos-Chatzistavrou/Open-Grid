/tools/nyc/.venv/
__pycache__/
.vercel
.env*

# garage asset build cache (downloads from Poly Haven)
/tools/garage/.cache/

# Large CC BY 4.0 physics measurement datasets (fetch with tools/physics/fetch-data.mjs)
